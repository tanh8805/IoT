# Bí mật
**/secrets.h
.env
deployment/mosquitto/config/passwd

# Dynamic Security chứa hash mật khẩu MQTT; mật khẩu thật không bao giờ vào git
**/dynamic-security.json
deployment/mosquitto/legacy/passwd

# Chứng chỉ HTTPS tự ký và khóa riêng: tạo cục bộ bằng deployment/scripts/gen-cert.mjs, không commit
deployment/certs/*
!deployment/certs/.gitkeep
*.key
*.pem

