// Schema PostgreSQL cho hệ thống tưới cây thông minh (bản dự phòng).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

// Vòng đời thiết bị: REGISTERED → PROVISIONED → ACTIVE ⇄ OFFLINE/FAULT → MAINTENANCE → DECOMMISSIONED
enum DeviceState {
  REGISTERED
  PROVISIONED
  ACTIVE
  OFFLINE
  FAULT
  MAINTENANCE
  DECOMMISSIONED
}

enum CommandStatus {
  PENDING
  OK
  ERROR
  TIMEOUT
}

enum AlertType {
  LOW_SOIL
  AUTO_BLOCKED
  DEVICE_OFFLINE
  ABNORMAL_DATA
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  fullName     String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  devices DeviceAssignment[]
}

// Mã thiết bị (chau-01...) cũng là tên đăng nhập MQTT và là phần <id> trong topic devices/<id>/...
model Device {
  id            String      @id
  name          String
  location      String      @default("")
  state         DeviceState @default(REGISTERED)
  lastSeenAt    DateTime?
  lastTelemetry Json?
  soilThreshold Int         @default(40)
  luxClose      Float       @default(10000)
  luxOpen       Float       @default(5000)
  createdAt     DateTime    @default(now())

  assignments  DeviceAssignment[]
  stateHistory DeviceStateHistory[]
  telemetry    Telemetry[]
  commands     Command[]
  configLog    ConfigChange[]
  alerts       Alert[]
}

model DeviceAssignment {
  userId   Int
  deviceId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([userId, deviceId])
}

model DeviceStateHistory {
  id       Int          @id @default(autoincrement())
  deviceId String
  from     DeviceState?
  to       DeviceState
  reason   String       @default("")
  actor    String       @default("system")
  at       DateTime     @default(now())
  device   Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, at])
}

model Telemetry {
  id          Int      @id @default(autoincrement())
  deviceId    String
  ts          DateTime
  receivedAt  DateTime @default(now())
  soilRaw     Int
  soilPct     Int
  lux         Float?
  pump        Boolean
  curtain     String?
  autoBlocked Boolean
  fw          String?
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, ts])
}

model Command {
  id        String        @id // chính là cmd_id (UUID) gửi xuống thiết bị
  deviceId  String
  action    String
  durationS Int?
  status    CommandStatus @default(PENDING)
  msg       String        @default("")
  userId    Int?
  username  String        @default("")
  createdAt DateTime      @default(now())
  ackedAt   DateTime?
  device    Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
}

model ConfigChange {
  id       Int      @id @default(autoincrement())
  deviceId String
  userId   Int?
  username String   @default("")
  oldValue Json
  newValue Json
  at       DateTime @default(now())
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, at])
}

model Alert {
  id           Int           @id @default(autoincrement())
  deviceId     String
  type         AlertType
  severity     AlertSeverity
  status       AlertStatus   @default(NEW)
  message      String
  createdAt    DateTime      @default(now())
  ackedById    Int?
  ackedByName  String?
  ackedAt      DateTime?
  resolvedAt   DateTime?
  device       Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, type, status])
  @@index([status, createdAt])
}

model AuditLog {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  userId   Int?
  username String   @default("system")
  action   String
  target   String?
  detail   Json?
  ip       String?

  @@index([at])
  @@index([action])
}

// Bản tin MQTT bị từ chối (sai định dạng, sai khoảng giá trị...)
model IngestError {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  deviceId String?
  topic    String
  payload  String
  reason   String

  @@index([at])
}
