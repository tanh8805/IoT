# Copy thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Broker MQTT. MQTT_HOST là IP của máy chạy Mosquitto (192.168.x.x), không dùng localhost
# khi cấu hình cho ESP32.
MQTT_HOST=
MQTT_PORT=1883

# Backend NestJS
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASS=

# Thiết bị thật (khớp MQTT_USER / MQTT_PASS trong firmware/smart_watering/secrets.h)
MQTT_DEVICE_USER=chau-01
MQTT_DEVICE_PASS=

# Thiết bị giả dùng để test (tests/integration/fake_device.py)
MQTT_FAKE_DEVICE_USER=chau-02
MQTT_FAKE_DEVICE_PASS=

# PostgreSQL và JWT cho backend
DATABASE_URL=postgresql://user:pass@localhost:5432/smart_watering
JWT_SECRET=

# Container postgres (phải khớp user/pass/db trong DATABASE_URL)
POSTGRES_USER=user
POSTGRES_PASSWORD=
POSTGRES_DB=smart_watering
