# Sao chép thành .env rồi điền giá trị thật, hoặc chạy: node deployment/scripts/init-env.mjs
# (script tự sinh mật khẩu ngẫu nhiên). KHÔNG commit file .env.

# Broker MQTT (bản này map cổng 1884 ra máy host).
# MQTT_HOST: dùng cho script chạy trên máy host (fake_device.py, test). Khi cấu hình ESP32 thật
# phải là IP LAN của máy chạy broker (192.168.x.x), không dùng localhost.
MQTT_HOST=localhost
MQTT_PORT=1884

# Tài khoản quản trị Dynamic Security, cũng là tài khoản của backend
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASS=

# Thiết bị thật (khớp MQTT_USER / MQTT_PASS trong firmware/smart_watering/secrets.h)
MQTT_DEVICE_USER=chau-01
MQTT_DEVICE_PASS=

# Thiết bị giả dùng để test (tests/integration/fake_device.py)
MQTT_FAKE_DEVICE_USER=chau-02
MQTT_FAKE_DEVICE_PASS=

# PostgreSQL (container dùng trực tiếp các biến POSTGRES_*)
POSTGRES_USER=smartwatering
POSTGRES_PASSWORD=
POSTGRES_DB=smart_watering
# Chỉ dùng khi chạy công cụ trên máy host (cổng 5433). Trong compose backend tự ghép URL.
DATABASE_URL=postgresql://smartwatering:DOI_MAT_KHAU@localhost:5433/smart_watering

# JWT cho backend
JWT_SECRET=
JWT_EXPIRES=8h
